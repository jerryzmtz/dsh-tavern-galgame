{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Presentation Migration Plan V1 (P7, inert P0 contract)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "baselineDigest", "inputs", "outputs", "unresolved", "rawStoryUnchanged"],
  "properties": {
    "version": { "const": 1 },
    "baselineDigest": { "$ref": "#/$defs/digest" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "unresolved": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "rawStoryUnchanged": { "const": true }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "digest", "kind"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$", "maxLength": 512 },
        "digest": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["config", "playback-v3", "index-v3", "figure-locks", "worldbook", "settings", "native-maintenance"] }
      }
    }
  }
}
