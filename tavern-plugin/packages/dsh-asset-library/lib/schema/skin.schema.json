       "enum": [
        "none",
        "jitter",
        "ink"
       ]
      },
      "jitter": {
       "type": "number",
       "minimum": 0,
       "maximum": 1.5
      }
     }
    },
    "cursor": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name"
     ],
     "properties": {
      "name": {
       "enum": [
        "triangle",
        "wheel",
        "lollipop",
        "eye",
        "rose",
        "rec",
        "candle",
        "gear",
        "light",
        "bell",
        "feather",
        "needle",
        "teacup",
        "whale"
       ]
      },
      "color": {
       "$ref": "#/$defs/color"
      },
      "accent": {
       "$ref": "#/$defs/color"
      },
      "fps": {
       "type": "number",
       "minimum": 2,
       "maximum": 12
      }
     }
    },
    "quickMenu": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "bg",
      "fg"
     ],
     "properties": {
      "bg": {
       "$ref": "#/$defs/color"
      },
      "fg": {
       "$ref": "#/$defs/color"
      }
     }
    },
    "sfx": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "type": {
       "$ref": "#/$defs/file"
      },
      "page": {
       "$ref": "#/$defs/file"
      },
      "open": {
       "$ref": "#/$defs/file"
      }
     }
    },
    "ui": {
     "$ref": "#/properties/ui"
    }
   }
  }
 }
}
